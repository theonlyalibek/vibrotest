{
 "buildCommand": "python3 -m venv /tmp/venv && /tmp/venv/bin/pip install -q -r requirements.txt && /tmp/venv/bin/python build.py --noindex --out public && /tmp/venv/bin/python build.py --noindex --v2 --out public/v2",
 "installCommand": "true",
 "outputDirectory": "public",
 "framework": null,
 "trailingSlash": true,
 "redirects": [
  {
   "source": "/",
   "destination": "/ru/",
   "permanent": false
  }
 ],
 "headers": [
  {
   "source": "/fonts/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    }
   ]
  }
 ]
}
